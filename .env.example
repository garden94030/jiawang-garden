# Server
PORT=3000

# Optional durable paths. Render must mount persistent storage at these paths
# before enabling writes in production.
DATA_DIR=./data
UPLOADS_DIR=./uploads

# Keep empty until a private management client is implemented.
# Generate a long random value and store the real value only in Render/GitHub secrets.
ADMIN_API_TOKEN=

# Disabled by default so the site never reports a lead as saved when durable
# delivery has not been configured.
CONTACT_FORM_ENABLED=false

# Public site URL used in generated links. Keep the real value in deployment config.
SITE_URL=https://jiawang-garden.onrender.com

# Social publishing is fail-closed. Both this switch and an explicit --live command
# are required before any adapter may make a publishing request.
SOCIAL_PUBLISH_LIVE=false

# Meta APIs. Set META_GRAPH_API_VERSION to a version currently supported by the
# Meta app; no version is guessed in code.
META_GRAPH_API_VERSION=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_SYNC_MAX_PAGES=5
FACEBOOK_MEDIA_MAX_BYTES=262144000
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# YouTube OAuth. Uploads are always private in the first release.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# S3-compatible durable object storage (for example Cloudflare R2).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

# AI copy is optional. When disabled or unavailable, deterministic Traditional
# Chinese copy is generated from the confirmed source text.
AI_COPY_ENABLED=false
AI_COPY_PROVIDER=
AI_COPY_MODEL=
AI_COPY_API_KEY=
