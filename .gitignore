# Dependencies
node_modules/

# User uploads (keep directory structure)
uploads/*
!uploads/.gitkeep

# Manual import inbox is local-only; imported records are tracked separately.
content/inbox/*
!content/inbox/.gitkeep

# Runtime data
data/shared-data.json

# Logs
*.log
server.log

# OS files
.DS_Store
Thumbs.db

# Next.js (if any remnants)
.next/
out/

# Build
/build

# Environment
.env
.env*.local
*.pem

# Debug
npm-debug.log*

# Local workflow summaries and resumable capability files are never committed.
facebook-sync-summary.json
social-publish-summary.json
